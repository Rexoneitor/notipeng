# Copia este archivo como .env.local y rellena con los datos de tu proyecto Supabase
# (Project Settings → API). La clave "anon"/"publishable" es pública por diseño:
# la seguridad la ponen las políticas RLS de supabase/schema.sql.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable
